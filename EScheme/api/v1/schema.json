{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgsgat6.github.io/EScheme/api/v1/schema.json",
  "title": "EScheme circuit specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "parts", "wires"],
  "properties": {
    "$schema": {"$ref":"#/$defs/text"},
    "format": {"const":"escheme/v1"},
    "name": {"$ref":"#/$defs/text"},
    "parts": {"type":"array","items":{"$ref":"#/$defs/part"}},
    "wires": {"type":"array","items":{"$ref":"#/$defs/wire"}},
    "custom": {"type":"array","items":{"$ref":"#/$defs/custom"}}
  },
  "$defs": {
    "text": {"type":"string","maxLength":200},
    "at": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":-100000,"maximum":100000}},
    "part": {
      "type":"object","additionalProperties":false,"required":["id","type","at"],
      "properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
        "type":{"anyOf":[{"enum":["battery","ac","resistor","capacitor","inductor","rheostat","ammeter","voltmeter","switch","junction"]},{"type":"string","pattern":"^custom-","maxLength":200}]},
        "at":{"$ref":"#/$defs/at","description":"Center [x,y], x right, y down."},
        "rotate":{"enum":[0,90,180,270],"default":0},
        "label":{"$ref":"#/$defs/text"},"name":{"$ref":"#/$defs/text"},"value":{"$ref":"#/$defs/text"}
      }
    },
    "endpoint": {"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}\\.[\\s\\S]+$","description":"Declared instance ID and actual port ID separated by a period."},
    "wire": {
      "type":"object","additionalProperties":false,"required":["from","to"],
      "properties":{"from":{"$ref":"#/$defs/endpoint"},"to":{"$ref":"#/$defs/endpoint"},"via":{"type":"array","items":{"$ref":"#/$defs/at"}}}
    },
    "custom": {
      "type":"object","required":["key","name","width","height","image","ports"],
      "properties":{
        "key":{"type":"string","pattern":"^custom-","maxLength":200},"name":{"$ref":"#/$defs/text"},
        "width":{"type":"number","exclusiveMinimum":0,"maximum":1000000},"height":{"type":"number","exclusiveMinimum":0,"maximum":1000000},
        "image":{"type":"string","pattern":"^data:image/png;base64,[A-Za-z0-9+/]+=*$"},
        "ports":{"type":"array","minItems":1,"items":{"type":"object","required":["id","x","y"],"properties":{"id":{"$ref":"#/$defs/text"},"x":{"type":"number","minimum":0,"maximum":1000000},"y":{"type":"number","minimum":0,"maximum":1000000}}}}
      }
    }
  }
}
